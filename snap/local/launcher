#!/bin/sh

if [ "$#" -eq 3 ] && [ "$2" = "import" ]; then
  if ! snapctl is-connected dot-bash-history && \
     ! snapctl is-connected dot-fish-history && \
     ! snapctl is-connected dot-resh-history && \
     ! snapctl is-connected dot-zsh-history; then
    echo "Error: Requested to import existing history but no interface connected which would allow this."
    echo "Please connect the appropriate interface such as: "
    echo ""
    echo "sudo snap connect $SNAP_NAME:dot-bash-history"
    echo ""
    echo "and try again."
    echo "To see which interfaces are available and whether they are connected:"
    echo ""
    echo "snap connections $SNAP_NAME"
    exit 1
  fi

  # Atuin looks for the bash history using directories::UserDirs::UserDir
  # which relies on $HOME. This env var is remapped in Snaps.
  # We thus workaround that by setting HISTFILE which takes precedence
  # in atuin loading logic.
  if snapctl is-connected dot-bash-history && [ -z "${HISTFILE}" ]; then
    export HISTFILE="${SNAP_REAL_HOME}/.bash_history"
  fi
fi

if [ "$#" -eq 3 ] && [ "$2" = "scripts" ]; then
  echo "Do to snap confinement, the 'scripts' command is not available."
  exit 1
fi

if [ "$#" -eq 4 ] && [ "$2" = "mcp" ] && [ "$3" = "install" ]; then
  srv="/snap/bin/${SNAP_NAME} mcp"
  case "$4" in
    claude-code|claude) alt="claude mcp add --scope user atuin" ;;
    codex)              alt="codex mcp add atuin" ;;
    # LP #1849753: opencode gives the server a socket for stdio,
    # which the snap can't read: relay it through pipes.
    opencode)           alt="opencode mcp add --global atuin"
                        srv="sh -c \"sed -u '' | ${srv} | sed -u ''\"" ;;
    pi)                 alt="pi mcp add atuin" ;;
    *)
      echo "Error: Unknown agent '${4}'."
      echo "Known agents: claude-code (claude), codex, opencode, pi."
      exit 1 ;;
  esac

  if [ -n "${alt}" ]; then
    echo "Warning: 'atuin mcp install $4' is not supported inside the snap:"
    echo "it needs the agent's own CLI or config, which a strictly confined snap can't reach."
    echo "Run this instead:"
    echo ""
    echo "  ${alt} -- ${srv}"
    echo ""
    exit 0
  fi
fi

if [ "$#" -eq 4 ] && [ "$2" = "hook" ] && [ "$3" = "install" ]; then
  agent="$4"
  # Atuin resolves the agents' config dirs from $HOME, which is remapped
  # inside the snap. Point them at the real home instead.
  case "${agent}" in
    claude-code|claude) plug="dot-claude";   var="CLAUDE_CONFIG_DIR";   dir="${SNAP_REAL_HOME}/.claude" ;;
    codex)              plug="dot-codex";    var="CODEX_HOME";          dir="${SNAP_REAL_HOME}/.codex" ;;
    opencode)           plug="dot-opencode"; var="XDG_CONFIG_HOME";     dir="${SNAP_REAL_HOME}/.config" ;;
    pi)                 plug="dot-pi";       var="PI_CODING_AGENT_DIR"; dir="${SNAP_REAL_HOME}/.pi/agent" ;;
    *)
      echo "Error: Unknown agent '${agent}'."
      echo "Known agents: claude-code (claude), codex, opencode, pi."
      exit 1 ;;
  esac

  if ! snapctl is-connected "${plug}"; then
    echo "The '${plug}' interface is not connected."
    echo ""
    echo "To connect the interface:"
    echo ""
    echo "  sudo snap connect ${SNAP_NAME}:${plug}"
    echo ""
    exit 1
  fi

  current="$(printenv "${var}")"
  if [ -z "${current}" ]; then
    export "${var}=${dir}"
  else
    echo "Warning: ${var}=${current} is set, but custom paths are not supported:" >&2
    echo "the '${plug}' interface only grants access to ${dir}. Trying anyway." >&2
    echo "" >&2
  fi

  # ATUIN_HOME takes precedence over XDG_CONFIG_HOME for atuin's own files, so
  # use a scratch dir to keep atuin from touching the real home.
  ATUIN_HOME="$(mktemp -d)"
  export ATUIN_HOME
  trap 'rm -rf "${ATUIN_HOME}"' EXIT

  # Atuin picks the opencode v1 or v2 plugin from `opencode --version`, which
  # isn't reachable from the snap: report the major version ourselves.
  # Furthermore, it install the v1 plugin by default.
  # We override this by providing a fake
  # `opencode --version` command that reports the desired major version & defaults to 2.
  if [ "${agent}" = "opencode" ]; then
    major="${ATUIN_OPENCODE_MAJOR:-2}"
    echo "Installing the plugin for opencode ${major}.x (set ATUIN_OPENCODE_MAJOR to change)."
    mkdir "${ATUIN_HOME}/bin"
    printf '#!/bin/sh\necho "opencode v%s"\n' "${major}" > "${ATUIN_HOME}/bin/opencode"
    chmod +x "${ATUIN_HOME}/bin/opencode"
    export PATH="${ATUIN_HOME}/bin:${PATH}"
  fi

  "$@"
  exit $?
fi

exec "$@"
